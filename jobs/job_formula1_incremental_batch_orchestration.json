{
  "name": "job_formula1_incremental_batch_orchestration",
  "email_notifications": {
    "no_alert_for_skipped_runs": false
  },
  "webhook_notifications": {},
  "timeout_seconds": 0,
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "01_Identify_Next_Batch",
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "/Workspace/Users/karanamsc@gmail.com/formula1-project-incremental-load/05-orchestration/01.Identify Next Batch",
        "source": "WORKSPACE"
      },
      "job_cluster_key": "Job_cluster",
      "timeout_seconds": 0,
      "email_notifications": {},
      "webhook_notifications": {},
      "disabled": false
    },
    {
      "task_key": "Is_There_A_Batch_To_Process",
      "depends_on": [
        {
          "task_key": "01_Identify_Next_Batch"
        }
      ],
      "run_if": "ALL_SUCCESS",
      "condition_task": {
        "op": "EQUAL_TO",
        "left": "{{tasks.01_Identify_Next_Batch.values.has_batch}}",
        "right": "true"
      },
      "timeout_seconds": 0,
      "email_notifications": {},
      "webhook_notifications": {},
      "disabled": false
    },
    {
      "task_key": "02_Create_New_Batch",
      "depends_on": [
        {
          "task_key": "Is_There_A_Batch_To_Process",
          "outcome": "true"
        }
      ],
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "/Workspace/Users/karanamsc@gmail.com/formula1-project-incremental-load/05-orchestration/02.Create New Batch",
        "base_parameters": {
          "p_batch_id": "{{tasks.01_Identify_Next_Batch.values.p_batch_id}}"
        },
        "source": "WORKSPACE"
      },
      "timeout_seconds": 0,
      "email_notifications": {},
      "webhook_notifications": {},
      "disabled": false
    },
    {
      "task_key": "run_job_formula1_lakehouse_incremental_refresh",
      "depends_on": [
        {
          "task_key": "02_Create_New_Batch"
        }
      ],
      "run_if": "ALL_SUCCESS",
      "run_job_task": {
        "job_id": 28888026740482,
        "job_parameters": {
          "p_batch_id": "{{tasks.01_Identify_Next_Batch.values.p_batch_id}}"
        }
      },
      "timeout_seconds": 0,
      "email_notifications": {},
      "webhook_notifications": {},
      "disabled": false
    },
    {
      "task_key": "03_Complete_Batch",
      "depends_on": [
        {
          "task_key": "run_job_formula1_lakehouse_incremental_refresh"
        }
      ],
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "/Workspace/Users/karanamsc@gmail.com/formula1-project-incremental-load/05-orchestration/03.Complete Batch",
        "base_parameters": {
          "p_batch_id": "{{tasks.01_Identify_Next_Batch.values.p_batch_id}}"
        },
        "source": "WORKSPACE"
      },
      "timeout_seconds": 0,
      "email_notifications": {},
      "webhook_notifications": {},
      "disabled": false
    }
  ],
  "job_clusters": [
    {
      "job_cluster_key": "Job_cluster",
      "new_cluster": {
        "cluster_name": "",
        "spark_version": "18.x-scala2.13",
        "azure_attributes": {
          "first_on_demand": 1,
          "availability": "SPOT_WITH_FALLBACK_AZURE",
          "spot_bid_max_price": -1
        },
        "node_type_id": "Standard_D4ds_v5",
        "enable_elastic_disk": true,
        "data_security_mode": "DATA_SECURITY_MODE_AUTO",
        "runtime_engine": "PHOTON",
        "num_workers": 8
      }
    }
  ],
  "queue": {
    "enabled": true
  },
  "performance_target": "PERFORMANCE_OPTIMIZED"
}